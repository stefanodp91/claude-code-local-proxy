# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Package managers ─────────────────────────────────────────────────────────
bun.lock
.npm/
.yarn/
.pnp.*

# ── Build output ─────────────────────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ── Angular ──────────────────────────────────────────────────────────────────
.angular/

# ── VS Code extension package ────────────────────────────────────────────────
*.vsix

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
proxy/proxy.log

# ── Environment (contains local paths/ports/secrets) ─────────────────────────
.env
.env.local
.env.*.local
proxy/.env.proxy
proxy/.env.claude

# ── Test coverage ────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Python (chat-extension code execution venv) ──────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── Editor backups & swap files ──────────────────────────────────────────────
*.swp
*.swo
*~
.idea/
*.sublime-workspace

.claude/
.claudio/
# …except the demo workspace's, which exists to be read: the skill and the hook
# in it are the thing being demonstrated, and a demo whose contents are ignored
# demonstrates nothing.
!demo-workspace/.claudio/
!demo-workspace/.claudio/**

# Which workspaces have had their hooks trusted, and the hash that trust was for.
# Local state with absolute paths in it, like model-cache.json is for probes —
# and it was committed by accident once, in a repository whose whole design is
# that trust is granted on this machine, by this person, for this content.
proxy/hooks-trust.json
